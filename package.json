{
  "name": "GitDiffToZip",
  "version": "0.0.2",
  "description": "A lightweight CLI tool that bundles only changed files between two Git commits into a single ZIP archive.",
  "main": "index.js",
  "bin": {
    "gdtz": "./index.js"
  },
  "scripts": {
    "build:win": "pkg . --target node18-win-x64 --output build/gdtz.exe",
    "build:linux": "pkg . --target node18-linux-x64 --output build/gdtz-linux",
    "build:mac": "pkg . --target node18-macos-x64 --output build/gdtz-macos",
    "build:all": "npm run build:win && npm run build:linux && npm run build:mac",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "git",
    "diff",
    "zip",
    "archive",
    "commit",
    "deployment",
    "cli",
    "tool"
  ],
  "author": "GitDiffToZip Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santa77/GitDiffToZip.git"
  },
  "bugs": {
    "url": "https://github.com/Santa77/GitDiffToZip/issues"
  },
  "homepage": "https://github.com/Santa77/GitDiffToZip#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "pkg": "^5.8.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "jest": "^30.2.0"
  }
}
